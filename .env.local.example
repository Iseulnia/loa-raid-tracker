# 이 파일을 복사해서 .env.local 로 저장하고 실제 값을 채워넣으세요.
# .env.local은 git에 커밋되지 않습니다.

# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# https://developer-lostark.game.onstove.com/ 에서 발급받은 오픈 API 키
# (서버에서만 사용되며 클라이언트에는 절대 노출되지 않음)
LOSTARK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 보석 가격 자동 수집(GitHub Actions 크론)용. 둘 다 절대 클라이언트에 노출되면 안 됨.
# SUPABASE_SERVICE_ROLE_KEY: Supabase 프로젝트 설정 > API > service_role 키 (RLS를 전부 무시하니 각별히 주의)
# CRON_SECRET: 아무 임의의 긴 문자열(예: openssl rand -hex 32) — GitHub Actions 쪽 시크릿과 값이 같아야 함
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
